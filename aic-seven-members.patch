+#gl.blurred{filter:blur(9px) saturate(.85) brightness(.6)}
+
+.lowerThird{position:absolute;left:20px;bottom:18px;z-index:5;display:flex;flex-direction:column;gap:8px;max-width:min(480px,74%)}
+.speakerCard{display:flex;align-items:center;gap:14px;background:rgba(4,8,16,.86);border:1px solid rgba(77,163,255,.35);
+  border-left:3px solid var(--cyan);padding:11px 16px}
+.speakerName{font-weight:600;font-size:14.5px}
+.speakerRole{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--cyan-dim);text-transform:uppercase;margin-top:2px}
+.wave{display:flex;align-items:flex-end;gap:2.5px;height:15px;margin-left:auto}
+.wave i{width:3px;height:4px;background:var(--cyan)}
+.quote{background:rgba(4,8,16,.8);border:1px solid var(--line);padding:10px 14px;font-size:13px;color:#CBD8EA;
+  opacity:0;transform:translateY(6px);transition:opacity .4s,transform .4s;line-height:1.5}
+.quote.show{opacity:1;transform:none}
+
+.sessionBar{position:absolute;right:20px;bottom:18px;z-index:5;display:flex;align-items:center;gap:10px;
+  background:rgba(4,8,16,.82);border:1px solid var(--line);border-radius:999px;padding:8px 10px 8px 16px;
+  font-family:var(--mono);font-size:11.5px;color:var(--slate)}
+.camBtn{background:none;border:1px solid var(--line);color:var(--slate);border-radius:999px;padding:7px 12px;
+  font-family:var(--mono);font-size:10.5px;cursor:pointer}
+.camBtn:hover{color:var(--ink);border-color:var(--cyan)}
+.floorBtn{background:var(--cyan);color:#04101F;font-weight:600;font-size:12px;border:none;border-radius:999px;
+  padding:8px 15px;cursor:pointer;font-family:var(--body)}
+.floorBtn:hover{filter:brightness(1.1)}
+.floorBtn:disabled{opacity:.5;cursor:default}
+
+/* deck */
+.deck{position:absolute;inset:0;z-index:6;padding:16px 20px 92px;display:flex;flex-direction:column;gap:12px;
+  pointer-events:none;overflow-y:auto;animation:deckIn .6s ease}
+.deck[hidden]{display:none}
+@keyframes deckIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
+.verdictBanner{pointer-events:auto;position:relative;display:flex;align-items:center;gap:24px;flex-wrap:wrap;
+  background:rgba(6,12,22,.74);border:1px solid rgba(34,197,94,.4);border-left:4px solid var(--up);padding:12px 18px}
+.vbLabel{font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--cyan-dim)}
+.vbDecision{font-size:30px;font-weight:700;color:var(--up);line-height:1.15}
+.vbStats{display:flex;gap:22px;flex-wrap:wrap;margin-left:auto;margin-right:20px}
+.vbStats div{display:flex;flex-direction:column;gap:2px}
+.vbStats span{font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:var(--slate);text-transform:uppercase}
+.vbStats b{font-family:var(--mono);font-size:16px;color:var(--ink);font-weight:500}
+.xBtn{background:none;border:none;color:var(--slate);font-size:15px;cursor:pointer;line-height:1}
+.xBtn:hover{color:var(--ink)}
+.deckClose{position:absolute;top:7px;right:9px}
+.panels{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;align-items:start}
+.glass{pointer-events:auto;background:rgba(6,12,22,.66);border:1px solid rgba(77,163,255,.22);padding:13px 15px}
+.glass h4{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--cyan);font-weight:500;
+  text-transform:uppercase;padding-bottom:7px;border-bottom:1px solid rgba(77,163,255,.2)}
+.glass .src{font-family:var(--mono);font-size:9.5px;color:var(--slate);margin:6px 0 6px}
+.glass table{width:100%;border-collapse:collapse;font-size:12px}
+.glass td{padding:5px 0;border-bottom:1px solid rgba(255,255,255,.05);vertical-align:top}
+.glass td:first-child{color:var(--slate);padding-right:10px}
+.glass td:last-child{text-align:right;font-family:var(--mono);color:var(--ink)}
+.glass tr:last-child td{border-bottom:none}
+.gUp{color:var(--up)!important}.gDown{color:var(--down)!important}.gWarn{color:var(--amber)!important}
+
