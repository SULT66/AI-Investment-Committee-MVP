+/* ============================================================
+   Voice — real TTS through /api/voice, lip-sync from the audio
+   ============================================================ */
+let voiceOn = false, audioCtx = null, analyser = null, srcNode = null, ampData = null;
+let amplitude = 0, voiceSeq = 0;
+const voiceCache = new Map();
+
+async function unlockAudio(){
+  try{
+    if (!audioCtx){
+      const C = window.AudioContext || window.webkitAudioContext;
+      audioCtx = new C();
+      analyser = audioCtx.createAnalyser();
+      analyser.fftSize = 512;
+      analyser.smoothingTimeConstant = .75;
+      analyser.connect(audioCtx.destination);
+      ampData = new Uint8Array(analyser.frequencyBinCount);
+    }
+    if (audioCtx.state === 'suspended') await audioCtx.resume();
+    return true;
+  } catch(e){ return false; }
+}
+function stopVoice(){
+  voiceSeq++;
+  if (srcNode){ try{ srcNode.onended = null; srcNode.stop(); }catch(e){} srcNode = null; }
+  people.forEach(p => p.talking = false);
+  amplitude = 0;
+}
+async function speak(memberIdx, text){
+  if (!voiceOn || !audioCtx || !text) return;
+  const m = MEMBERS[memberIdx];
+  const token = ++voiceSeq;
+  if (srcNode){ try{ srcNode.onended = null; srcNode.stop(); }catch(e){} srcNode = null; }
+  people.forEach(p => p.talking = false);
+
+  const cacheKey = m.id + '|' + lang + '|' + text;
+  let buf = voiceCache.get(cacheKey);
+  if (!buf){
+    try{
+      const r = await fetch('/api/voice', {
+        method:'POST', headers:{'Content-Type':'application/json'},
+        body: JSON.stringify({ text, language: lang, member: m.id })
+      });
+      if (!r.ok) throw new Error('voice ' + r.status);
+      buf = await audioCtx.decodeAudioData(await r.arrayBuffer());
+      if (voiceCache.size > 50) voiceCache.delete(voiceCache.keys().next().value);
+      voiceCache.set(cacheKey, buf);
+    } catch(err){
+      console.error('Voice failed', err);
+      note(t().errVoice, true);
+      return;
+    }
+  }
+  if (token !== voiceSeq) return;
+  const s = audioCtx.createBufferSource();
+  s.buffer = buf; s.connect(analyser);
+  s.onended = () => { if (srcNode === s){ srcNode = null; people.forEach(p=>p.talking=false); amplitude = 0; } };
+  srcNode = s; people[memberIdx].talking = true;
+  s.start();
+}
+const voiceBtn = document.getElementById('voiceBtn');
+voiceBtn.addEventListener('click', async ()=>{
