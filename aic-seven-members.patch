+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8" />
+<meta name="viewport" content="width=device-width,initial-scale=1" />
+<title>AIC · Committee Room</title>
+<style>
+:root{
+  --bg:#040810;--bar:#060B16;--line:#122036;--cyan:#4DA3FF;--cyan-dim:#8FB8E8;
