+    : /how much|сколько|allocat|размер|portfolio|портфел/.test(s) ? 'portfolio'
+    : /market|рынок|momentum|цена|price/.test(s) ? 'market' : 'chairman';
+  const lines = {
+    risk:'Concentration is the binding constraint. Even a sharp drawdown stays inside mandate at this size.',
+    fundamental:'The premium is real, but earnings growth still outpaces the multiple.',
+    portfolio:'A staged entry keeps the position inside the allocation band.',
