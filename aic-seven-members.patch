+  scr.fillText((up?'▲ ':'▼ ') + Math.abs(md.changePercent||0).toFixed(2) + '%  ·  FINNHUB', 48, 182);
+
+  if (sessionState === 'qa' && session){
+    scr.fillStyle='#8FB8E8'; scr.font='600 26px sans-serif';
+    scr.fillText(L.pVotes.toUpperCase(), 48, 246);
