+  if (md.epsTTM != null) numbers.push('EPS ' + Number(md.epsTTM).toFixed(2));
+  if (md.beta != null)   numbers.push('beta ' + Number(md.beta).toFixed(2));
+  if (md.fiftyTwoWeekLow != null && md.fiftyTwoWeekHigh != null)
+    numbers.push('52W ' + Number(md.fiftyTwoWeekLow).toFixed(0) + '–' + Number(md.fiftyTwoWeekHigh).toFixed(0));
+  if (numbers.length) script.splice(3, 0, { seat:quant, text: t().readsFigures + ' ' + numbers.join(' · ') + '.' });
+
+  const trigger = (session.reviewTriggers || [])[0] || (session.risks || [])[0];
+  if (trigger) script.push({ seat:macro, text: trigger });
