+    minutes.forEach((r,i)=>{
+      const y = 306 + i*54;
+      scr.fillStyle='#EAF1FA'; scr.font='500 26px sans-serif';
+      scr.fillText(fit(scr, r.name+' · '+r.role, 620), 48, y);
+      scr.fillStyle=voteColor(r.vote); scr.font='600 24px monospace';
+      scr.textAlign='right'; scr.fillText(String(r.vote).replace('_',' ').toUpperCase(), 940, y); scr.textAlign='left';
+      scr.strokeStyle='#0F1B2E'; scr.beginPath(); scr.moveTo(48,y+16); scr.lineTo(940,y+16); scr.stroke();
+    });
+    scr.fillStyle='#8FB8E8'; scr.font='600 28px sans-serif';
+    scr.fillText(L.decision, 1010, 82);
+    scr.fillStyle=voteColor(session.decision); scr.font='700 76px sans-serif';
+    scr.fillText(String(session.decision||'').replace('_',' ').toUpperCase(), 1010, 168);
+    scr.fillStyle='#EAF1FA'; scr.font='500 30px monospace';
+    scr.fillText(L.conf+' '+pct((session.confidence||0)*100), 1010, 232);
+    scr.fillText(L.amount+' '+money(session.proposedInvestmentAmount), 1010, 282);
+    scr.fillText(L.alloc+' '+(Number(session.proposedPortfolioAllocationPercent)||0).toFixed(1)+'%', 1010, 332);
+    scr.fillStyle='#7E8CA3'; scr.font='400 24px sans-serif';
+    (session.reasons||[]).slice(0,3).forEach((r,i)=> scr.fillText(fit(scr,'• '+r,540), 1010, 396+i*40));
+  } else {
+    scr.fillStyle='#54607A'; scr.font='400 28px sans-serif';
+    scr.fillText(L.connecting, 48, 250);
+    minutes.forEach((r,i)=>{
+      const y = 306 + i*54;
+      scr.fillStyle='#EAF1FA'; scr.font='500 26px sans-serif';
+      scr.fillText(fit(scr, r.name+' · '+r.role, 620), 48, y);
+      scr.fillStyle=voteColor(r.vote); scr.font='600 24px monospace';
+      scr.textAlign='right'; scr.fillText(String(r.vote).replace('_',' ').toUpperCase(), 940, y); scr.textAlign='left';
+    });
+  }
+  scrTex.needsUpdate = true;
+}
+
+/* ============================================================
+   Render loop
+   ============================================================ */
+function resize(){
+  const w = stageEl.clientWidth, h = stageEl.clientHeight;
+  renderer.setSize(w, h, false);
+  camera.aspect = w/h; camera.updateProjectionMatrix();
+}
+resize(); addEventListener('resize', resize);
+
+const clock = new THREE.Clock();
+function animate(){
+  requestAnimationFrame(animate);
+  const tt = clock.getElapsedTime();
+
+  if (analyser && srcNode){
+    analyser.getByteTimeDomainData(ampData);
+    let peak = 0;
+    for (let i=0;i<ampData.length;i++){ const v = Math.abs(ampData[i]-128)/128; if (v>peak) peak = v; }
+    amplitude += (Math.min(1, peak*2.2) - amplitude) * .35;
+  } else amplitude += (0 - amplitude) * .2;
+
+  people.forEach((o,i)=>{
+    const speaking = i === activeIdx;
+    o.group.position.y = Math.sin(tt*1.1 + o.phase) * .012;
+    o.group.rotation.y = o.baseRotY + Math.sin(tt*.45 + o.phase) * .04;
+    if (speaking){
+      const q0 = o.headG.quaternion.clone();
+      o.headG.lookAt(camera.position);
+      const q1 = o.headG.quaternion.clone();
+      o.headG.quaternion.copy(q0).slerp(q1, .16);
+      o.headG.rotation.x += Math.sin(tt*7.5)*.02;
+      const amp = o.talking ? amplitude : (voiceOn ? 0 : Math.abs(Math.sin(tt*9))*.45);
+      o.mouth.scale.y += (.28 + amp*1.6 - o.mouth.scale.y) * .35;
+      o.mouth.scale.z = .5 + amp*.25;
+    } else {
+      let lookX = 0;
+      if (activeIdx >= 0){
+        const sp = people[activeIdx].group.position;
+        lookX = THREE.MathUtils.clamp(Math.atan2(sp.x - o.group.position.x, sp.z - o.group.position.z + 6)*.55, -.5, .5);
+      }
+      o.headG.rotation.z *= .9;
+      o.headG.rotation.y += (lookX - o.headG.rotation.y)*.06;
+      o.headG.rotation.x += (Math.sin(tt*.7+o.phase)*.03 - o.headG.rotation.x)*.08;
+      o.mouth.scale.y += (.28 - o.mouth.scale.y)*.2;
+    }
+    const cur = o.ring.material.opacity;
+    o.ring.material.opacity = cur + ((o.ringGoal||0) + (speaking?Math.sin(tt*4)*.12:0) - cur)*.08;
+  });
+
+  puckRing.material.opacity = .5 + Math.sin(tt*2)*.3;
+  document.querySelectorAll('#wave i').forEach((el,i)=>{
+    const a = activeIdx >= 0 ? (amplitude || (voiceOn?0:Math.abs(Math.sin(tt*8+i))*.5)) : 0;
+    el.style.height = (4 + a*11 * (1 - Math.abs(i-2)*.15)) + 'px';
+  });
+
+  if (lerpF > 0){ camPos.lerp(goalPos, lerpF); camTgt.lerp(goalTgt, lerpF); }
+  camera.position.copy(camPos);
+  if (!reduced){ camera.position.x += Math.sin(tt*.5)*.04; camera.position.y += Math.sin(tt*.8)*.025; }
+  camera.lookAt(camTgt);
+  renderer.render(scene, camera);
+}
+animate();
+
+/* ============================================================
+   Market ticker — live from /api/market-data, user-editable
+   ============================================================ */
+const DEFAULT_SYMS = ['SPY','QQQ','DIA','NVDA','AAPL','MSFT','AMZN','GOOGL','META','TSLA'];
+const CATALOG = ['SPY','QQQ','DIA','IWM','NVDA','AAPL','MSFT','AMZN','GOOGL','META','TSLA','AMD','AVGO','NFLX','JPM','V','XOM','COIN','PLTR','UBER'];
+let symbols = DEFAULT_SYMS.slice();
+try { const s = JSON.parse(localStorage.getItem('aic-symbols')||'null'); if (Array.isArray(s) && s.length) symbols = s; } catch(e){}
+const saveSyms = () => { try{ localStorage.setItem('aic-symbols', JSON.stringify(symbols)); }catch(e){} };
+
+const quotes = {};
+const tickRow = document.getElementById('tickRow');
+const mTrack  = document.getElementById('mTrack');
+
+function renderTickerShell(){
+  tickRow.innerHTML = symbols.map((s,i)=>
+    '<div class="tick"><div class="sym">'+s+'</div><div class="px" id="px'+i+'">—</div><div class="chg" id="ch'+i+'">—</div></div>').join('');
+  const span = symbols.map((s,i)=>'<span><b>'+s+'</b> <em class="mp'+i+'">—</em> <i class="mc'+i+'"></i></span>').join('');
+  mTrack.innerHTML = span + span;
+  paintTicker();
+}
+function paintTicker(){
+  symbols.forEach((s,i)=>{
+    const q = quotes[s];
+    const pxEl = document.getElementById('px'+i), chEl = document.getElementById('ch'+i);
+    if (!pxEl) return;
+    if (!q){ pxEl.textContent='—'; chEl.textContent=''; return; }
+    const up = (q.changePercent||0) >= 0;
+    const pxTxt = Number(q.currentPrice).toFixed(2);
+    const chTxt = (up?'▲ ':'▼ ') + Math.abs(q.changePercent||0).toFixed(2) + '%';
+    if (pxEl.textContent !== '—' && pxEl.textContent !== pxTxt){
+      pxEl.classList.remove('flashUp','flashDown'); void pxEl.offsetWidth;
+      pxEl.classList.add(Number(pxTxt) >= Number(pxEl.textContent) ? 'flashUp' : 'flashDown');
+    }
+    pxEl.textContent = pxTxt;
+    chEl.textContent = chTxt;
+    chEl.className = 'chg ' + (up?'chgUp':'chgDown');
+    document.querySelectorAll('.mp'+i).forEach(e=> e.textContent = pxTxt);
+    document.querySelectorAll('.mc'+i).forEach(e=>{ e.textContent = chTxt.replace(' ',''); e.className='mc'+i+' '+(up?'upTxt':'downTxt'); });
+  });
+}
+const DEMO_PX = {SPY:612.4,QQQ:548.2,DIA:441.8,IWM:232.1,NVDA:182.44,AAPL:231.06,MSFT:512.1,AMZN:224.9,
+  GOOGL:198.3,META:702.4,TSLA:268.51,AMD:162.38,AVGO:1402.55,NFLX:648.12,JPM:201.44,V:334.7,XOM:118.2,
+  COIN:274.6,PLTR:88.4,UBER:79.3};
+async function refreshQuotes(){
+  let ok = false;
+  for (const s of symbols){
+    try{
+      const r = await fetch('/api/market-data?symbol=' + encodeURIComponent(s));
+      if (!r.ok) throw new Error(String(r.status));
+      quotes[s] = await r.json(); ok = true;
+      if (s === PROPOSAL.ticker){ market = quotes[s]; drawScreen(); }
+    } catch(e){
+      /* demo quotes so the room is viewable without the backend */
+      const base = DEMO_PX[s] || 100;
+      const prev = quotes[s] ? quotes[s].currentPrice : base;
+      const px = Math.max(1, prev + (Math.random()-.48) * base * 0.0012);
+      quotes[s] = {symbol:s, currentPrice:px, changePercent:(px/base-1)*100 + 0.8, currency:'USD'};
+    }
+  }
+  if (!ok) demoBadge();
+  paintTicker();
+}
+function demoBadge(){
+  if (document.getElementById('demoBadge')) return;
+  const b = document.createElement('span');
+  b.id = 'demoBadge';
+  b.textContent = 'DEMO DATA';
+  b.style.cssText = 'margin-left:12px;font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;'+
+    'color:var(--amber);border:1px solid var(--amber);padding:3px 8px;border-radius:999px';
+  document.querySelector('.livePill').after(b);
+}
+renderTickerShell();
+refreshQuotes();
+setInterval(refreshQuotes, 60000);
+
+/* ticker editor */
+const modal = document.getElementById('tickModal');
+const symGrid = document.getElementById('symGrid');
+const symErr = document.getElementById('symErr');
+const showErr = m => { symErr.textContent = m; symErr.hidden = false; };
+function renderGrid(){
+  const all = Array.from(new Set([...CATALOG, ...symbols]));
+  symGrid.innerHTML = all.map(s=>{
+    const on = symbols.includes(s), custom = !CATALOG.includes(s);
+    return '<div class="symChip '+(on?'on':'')+'" data-sym="'+s+'"><span class="symBox">'+(on?'✓':'')+'</span><span>'+s+'</span>'+
+      (custom?'<span class="symDrop" data-del="'+s+'">✕</span>':'')+'</div>';
+  }).join('');
+}
+symGrid.addEventListener('click', e=>{
+  const del = e.target.closest('[data-del]');
+  if (del){ symbols = symbols.filter(x=>x!==del.dataset.del); saveSyms(); renderGrid(); renderTickerShell(); refreshQuotes(); return; }
+  const chip = e.target.closest('.symChip'); if (!chip) return;
+  const s = chip.dataset.sym;
+  if (symbols.includes(s)){
+    if (symbols.length <= 3) return showErr(t().errMin);
+    symbols = symbols.filter(x=>x!==s);
+  } else {
+    if (symbols.length >= 14) return showErr(t().errMax);
+    symbols.push(s);
+  }
+  symErr.hidden = true; saveSyms(); renderGrid(); renderTickerShell(); refreshQuotes();
+});
+async function addSymbol(){
+  const input = document.getElementById('symInput');
+  const s = input.value.trim().toUpperCase();
+  if (!s) return;
+  if (symbols.includes(s)) return showErr(t().errDup);
+  if (symbols.length >= 14) return showErr(t().errMax);
+  try{
+    const r = await fetch('/api/market-data?symbol=' + encodeURIComponent(s));
+    if (!r.ok) throw new Error('bad symbol');
+    quotes[s] = await r.json();
+  } catch(e){ return showErr('“'+s+'” — ?'); }
+  symbols.push(s); input.value=''; symErr.hidden = true;
+  saveSyms(); renderGrid(); renderTickerShell();
+}
+document.getElementById('addSym').addEventListener('click', addSymbol);
+document.getElementById('symInput').addEventListener('keydown', e=>{ if (e.key==='Enter') addSymbol(); });
+document.getElementById('editTicks').addEventListener('click', ()=>{ renderGrid(); symErr.hidden=true; modal.hidden=false; });
+const closeModal = ()=> modal.hidden = true;
+document.getElementById('closeTicks').addEventListener('click', closeModal);
+document.getElementById('doneTicks').addEventListener('click', closeModal);
+modal.addEventListener('click', e=>{ if (e.target === modal) closeModal(); });
+addEventListener('keydown', e=>{ if (e.key==='Escape' && !modal.hidden) closeModal(); });
+document.getElementById('resetTicks').addEventListener('click', ()=>{
+  symbols = DEFAULT_SYMS.slice(); saveSyms(); renderGrid(); renderTickerShell(); refreshQuotes();
+});
+
+/* ============================================================
+   Language + chrome
+   ============================================================ */
+function applyLang(){
+  const L = t();
+  document.documentElement.lang = lang;
+  document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
+  document.getElementById('liveTxt').textContent = L.live;
+  document.getElementById('floorBtn').textContent = L.floor;
+  document.getElementById('qaSend').textContent = L.ask;
+  document.getElementById('qaInput').placeholder = L.askPh;
+  document.getElementById('newSession').textContent = L.newSession;
+  document.getElementById('tickerLabel').textContent = L.ticker;
+  document.getElementById('newsLabel').textContent = L.session;
+  document.getElementById('editTxt').textContent = L.edit;
+  document.getElementById('mTitle').textContent = L.tickTitle;
+  document.getElementById('mHint').textContent = L.tickHint;
+  document.getElementById('addSym').textContent = L.add;
+  document.getElementById('resetTicks').textContent = L.reset;
+  document.getElementById('doneTicks').textContent = L.done;
+  paintVoiceBtn();
+  if (sessionState === 'qa' && session) buildDeck();
+  drawScreen();
+  try{ localStorage.setItem('aic-lang', lang); }catch(e){}
+}
+const langSel = document.getElementById('langSel');
+langSel.value = lang;
+langSel.addEventListener('change', e=>{
+  lang = e.target.value;
+  applyLang();
+  stopVoice();
+  runSession();          /* the committee re-convenes in the new language */
+});
+applyLang();
+
+/* session strip + clock */
+const newsTrack = document.getElementById('newsTrack');
+function paintStrip(){
+  const parts = [
+    '<span><time>'+PROPOSAL.ticker+'</time>'+money(PROPOSAL.amount)+' proposed</span>',
+    '<span><time>PORTFOLIO</time>'+money(PROPOSAL.portfolioValue)+'</span>',
+    '<span><time>SECTOR</time>'+PROPOSAL.currentSectorExposure+'%</span>',
+    '<span><time>RISK</time>'+PROPOSAL.riskTolerance+'</span>',
+    '<span><time>HORIZON</time>'+PROPOSAL.horizonYears+'y</span>'
+  ];
+  if (session) parts.push('<span><time>DECISION</time>'+String(session.decision||'').replace('_',' ').toUpperCase()+
+    ' · '+pct((session.confidence||0)*100)+'</span>');
+  newsTrack.innerHTML = parts.join('') + parts.join('');
+}
+paintStrip();
+setInterval(()=>{
+  secs++;
+  document.getElementById('timer').textContent =
+    String(Math.floor(secs/60)).padStart(2,'0')+':'+String(secs%60).padStart(2,'0');
+  document.getElementById('clock').textContent =
+    new Date().toLocaleTimeString(LOCALES[lang]||'en-US',
+      {hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'America/New_York'}) + ' ET';
+  if (sessionState === 'qa') paintStrip();
+}, 1000);
+
+/* the landing page / parent frame can start a session with its own proposal */
+addEventListener('message', e=>{
+  const d = e.data;
+  if (!d || d.type !== 'aic-proposal' || !d.proposal) return;
+  Object.assign(PROPOSAL, d.proposal);
+  paintStrip();
+  runSession();
+});
+
+drawScreen();
+runSession();
+</script>
+</body></html>
