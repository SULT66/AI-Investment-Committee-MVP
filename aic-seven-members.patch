+.qaBar{position:absolute;left:20px;right:20px;bottom:16px;z-index:7;display:flex;gap:9px;
+  background:rgba(6,12,22,.86);border:1px solid var(--line);padding:9px}
+.qaBar[hidden]{display:none}
+.qaBar input{flex:1;background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--ink);padding:10px 13px;font-size:13.5px}
+.qaBar input:focus{outline:none;border-color:var(--cyan)}
+.qaSend{background:var(--cyan);color:#04101F;font-weight:600;border:none;padding:10px 20px;font-size:13px;cursor:pointer}
+.qaSend:hover{filter:brightness(1.1)}
+.qaSend:disabled{opacity:.5;cursor:default}
+
+/* bottom dock */
+.bottomDock{flex:none;background:var(--bar);border-top:1px solid var(--line)}
+.tickerHead{display:flex;align-items:center;padding:6px 20px 0;font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--slate)}
+.editBtn{background:none;border:1px solid var(--line);color:var(--slate);font-family:var(--mono);font-size:9.5px;
+  letter-spacing:.1em;padding:3px 9px;border-radius:999px;cursor:pointer;margin-left:12px}
+.editBtn:hover{color:var(--cyan);border-color:var(--cyan)}
+.headSpacer{flex:1}
