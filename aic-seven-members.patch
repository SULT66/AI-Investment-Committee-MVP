+.flashUp{animation:flU 1s ease-out}.flashDown{animation:flD 1s ease-out}
+@keyframes flU{0%{color:#22C55E;text-shadow:0 0 12px rgba(34,197,94,.7)}100%{color:var(--ink)}}
+@keyframes flD{0%{color:#EF4444;text-shadow:0 0 12px rgba(239,68,68,.7)}100%{color:var(--ink)}}
+.newsRow{display:flex;align-items:center;gap:14px;border-top:1px solid var(--line);padding:7px 20px;font-size:12px;overflow:hidden}
+.newsLabel{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--amber);white-space:nowrap;background:var(--bar);padding-right:12px;z-index:2}
+.newsViewport{flex:1;overflow:hidden;min-width:0}
