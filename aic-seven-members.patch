+    const ok = await unlockAudio();
+    if (!ok){ note(t().errVoice, true); return; }
+    voiceOn = true;
+    note(t().aiVoice);
+    if (activeIdx >= 0) speak(activeIdx, lastLine);
+  } else {
+    voiceOn = false; stopVoice();
+  }
+  paintVoiceBtn();
+});
+function paintVoiceBtn(){
+  voiceBtn.textContent = voiceOn ? t().voiceOn : t().voiceOff;
+  voiceBtn.style.borderColor = voiceOn ? 'rgba(34,197,94,.5)' : '';
