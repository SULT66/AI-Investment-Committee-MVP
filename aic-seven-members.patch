+  scr.fillStyle='#040A14'; scr.fillRect(0,0,1600,560);
+  scr.strokeStyle='#12233C'; scr.lineWidth=2;
+  for(let x=0;x<=1600;x+=100){scr.beginPath();scr.moveTo(x,0);scr.lineTo(x,560);scr.stroke();}
+  for(let y=0;y<=560;y+=70){scr.beginPath();scr.moveTo(0,y);scr.lineTo(1600,y);scr.stroke();}
+}
