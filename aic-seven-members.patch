+}
+*{margin:0;padding:0;box-sizing:border-box}
+html,body{height:100%}
+body{background:var(--bg);color:var(--ink);font-family:var(--body);display:flex;flex-direction:column;overflow:hidden}
+button,select,input{font-family:inherit}
+a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
+
+/* top dock */
+.topDock{flex:none;background:rgba(6,11,22,.94);border-bottom:1px solid var(--line)}
+.nav{display:flex;align-items:center;gap:18px;padding:11px 20px}
+.logo{font-weight:700;font-size:22px;color:var(--cyan);letter-spacing:.5px}
+.brandText{font-size:10.5px;letter-spacing:.12em;color:var(--slate);line-height:1.3}
+.livePill{display:flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;color:var(--up);
+  border:1px solid rgba(34,197,94,.35);padding:5px 11px;border-radius:999px}
+.liveDot{width:6px;height:6px;border-radius:50%;background:var(--up);animation:pulse 1.6s infinite}
+@keyframes pulse{50%{opacity:.35}}
+.navRight{margin-left:auto;display:flex;align-items:center;gap:9px}
+.pillBtn{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--ink);border:1px solid var(--line);
+  background:rgba(255,255,255,.03);padding:8px 14px;border-radius:999px;cursor:pointer}
+.pillBtn:hover{border-color:var(--cyan)}
+select.pillBtn{padding:8px 10px}
+.marquee{border-top:1px solid var(--line);overflow:hidden;font-family:var(--mono);font-size:11.5px}
+.marqueeTrack{display:flex;gap:40px;white-space:nowrap;width:max-content;padding:6px 0;animation:tickAnim 46s linear infinite}
+.marqueeTrack span{color:var(--slate)}
