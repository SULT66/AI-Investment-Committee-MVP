+    chairman:'The committee stands by the recorded decision. This is demo data — connect the API for a real answer.'
+  };
+  return { turns:[
+      {member:'chairman', role:'Committee Chair', kind:'statement', text:'Noted. Let the responsible member answer.'},
+      {member:pick, role:pick, kind:'statement', text:lines[pick]}
