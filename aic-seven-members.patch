erial({color:0x0b1321,metalness:.3}));chair.position.set(0,1.4,-.38);g.add(chair);return{g,head}}const people=[];members.forEach((m,i)=>{const a=(i-3)*.42,p=makeMember(m);p.g.position.set(Math.sin(a)*3.55,0,-Math.cos(a)*2.8-.25);p.g.lookAt(Math.sin(a)*7,0,7);p.phase=Math.random()*6.28;people.push(p);scene.add(p.g)});let active=3;const quotes=['Strong moat and disciplined execution.','Revenue acceleration is real.','Valuation requires caution.','The floor is open on the NVDA proposal.','Size the position to the downside risk.','Macro conditions may compress multiples.','Blackwell execution remains the key catalyst.'];setInterval(()=>{active=(active+1)%people.length;document.getElementById('speaker').textContent=members[active][0]+' · '+members[active][1];document.getElementById('quote').textContent=quotes[active]},5200);function resize(){renderer.setSize(stage.clientWidth,stage.clientHeight,false);camera.aspect=stage.clientWidth/stage.clientHeight;camera.updateProjectionMatrix()}addEventListener('resize',resize);resize();const clock=new THREE.Clock();function animate(){requestAnimationFrame(animate);const t=clock.getElapsedTime();people.forEach((p,i)=>{p.g.position.y=Math.sin(t*1.1+p.phase)*.012;p.head.rotation.y+=(i===active?Math.sin(t*2)*.12:0-p.head.rotation.y)*.05;p.head.rotation.x+=(i===active?Math.sin(t*6)*.03:0-p.head.rotation.x)*.08});camera.position.x=Math.sin(t*.18)*.25;camera.lookAt(0,2,-1);renderer.render(scene,camera)}animate();draw();setInterval(draw,1400);const syms=['SPY','QQQ','DIA','NVDA','AAPL','MSFT','AMZN','GOOGL','META','TSLA'];const ticker=document.getElementById('ticker');ticker.innerHTML=syms.map(s=>`<div class="tick"><b>${s}</b><span id="p-${s}">—</span><em id="c-${s}">LIVE</em></div>`).join('');async function load(symbol){const r=await fetch('/api/market-data?symbol='+symbol);if(!r.ok)throw 0;return r.json()}async function refresh(){for(const s of syms){try{const d=await load(s);document.getElementById('p-'+s).textContent=d.price?'$'+Number