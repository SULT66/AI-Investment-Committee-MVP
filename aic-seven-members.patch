+function fit(ctx, s, maxW){
+  if (ctx.measureText(s).width <= maxW) return s;
+  let out = s;
+  while (out.length > 4 && ctx.measureText(out+'…').width > maxW) out = out.slice(0,-1);
+  return out + '…';
+}
