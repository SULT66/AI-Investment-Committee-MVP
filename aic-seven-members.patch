+}
+function closeUp(i){
+  if (!autoCam) return;
+  const p = people[i].group.position;
+  const hp = new THREE.Vector3(p.x, 1.86, p.z);
+  const f = new THREE.Vector3(-.6*p.x, 0, 7-p.z).normalize();
+  shotCount++;
+  const kind = shotCount % 3;
+  let d0 = 2.9, d1 = 2.1, hy = 2.05;
+  if (kind === 1){ d0 = 2.4; d1 = 1.75; hy = 1.99; }
+  if (kind === 2){ d0 = 2.9; d1 = 2.15; hy = 1.74; }
+  const start = hp.clone().add(f.clone().multiplyScalar(d0)); start.y = hy;
+  const end   = hp.clone().add(f.clone().multiplyScalar(d1)); end.y = hy + .03;
+  cutTo(start, end, hp, .010);
+}
